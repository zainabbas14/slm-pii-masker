# Copy to .env and adjust. Every value has a sensible default.

# Model backend: ollama | llamacpp | rules_only (regex fallback only, no model)
BACKEND=ollama

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=pii-masker
# Constrained decoding: schema (JSON schema from Pydantic) | json | none
OLLAMA_FORMAT=schema

# llama.cpp llama-server (OpenAI-compatible)
LLAMACPP_URL=http://localhost:8080

# Limits
REQUEST_TIMEOUT_S=60
MAX_INPUT_CHARS=6000
NUM_CTX=4096

# Re-scan model output with deterministic regex and mask anything it missed
ENABLE_REGEX_GUARD=true

# Only needed for the notebooks (Colab Secrets is preferred there)
HF_TOKEN=
WANDB_API_KEY=
